# Copy this file to .env and fill in your values
# cp .env.example .env

APP_NAME=VoiceAuth
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TEMP_TOKEN_EXPIRE_MINUTES=10

DATABASE_URL=sqlite:///./voice_auth.db

# Similarity thresholds — calibrate empirically on real enrollment/test pairs
SIMILARITY_THRESHOLD_SIGNIN=0.75
SIMILARITY_THRESHOLD_DASHBOARD=0.70
ANTISPOOF_THRESHOLD=0.5

# Pipeline control
ANTISPOOF_BEFORE_ENHANCE=False
ANTISPOOF_ENABLED=True
VAD_ENABLED=True
ENHANCE_ENABLED=True

# Rate limiting
MAX_VOICE_ATTEMPTS=5
VOICE_LOCKOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
